# Your footage, renders, and keys stay local (style, rules, and styles/ are tracked)
.env
inbox/*
outbox/*
my-sounds/*
!inbox/.gitkeep
!outbox/.gitkeep
!my-sounds/.gitkeep
styles/.cache/
*.transcribe.mp3

# Sync tools
*.sync-conflict-*
~syncthing~*
.stfolder/
.stversions/
.DS_Store
Thumbs.db
__pycache__/
